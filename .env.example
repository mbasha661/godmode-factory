# === Shared ===
APP_ENV=development
# === Supabase (server-side only values are marked) ===
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SERVER ONLY - never in browser
SUPABASE_STORAGE_BUCKET=artifacts
# === API ===
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
# === AI provider (server-side only) ===
AI_PROVIDER=gemini            # gemini | groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# === Limits (spec section 6 defaults) ===
MAX_CONCURRENT_AI_TASKS=1
MAX_REPAIR_ATTEMPTS=2
MAX_TASKS_PER_RUN=30
MAX_PROMPT_CHARS=12000
MAX_WORKFLOW_DURATION_MINUTES=30
MAX_FILE_SIZE_MB=5
MAX_TEST_RETRIES=1
# === Web ===
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
